# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values.
# NEVER commit .env to version control!
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET

# OneSignal Push Notifications
# Get the App ID from: https://onesignal.com → Your App → Settings → Keys & IDs
#
# NOTE (Task 43.1, 2026-06-28): ONE_SIGNAL_REST_API_KEY is intentionally
# NOT in this file. The REST API key was previously bundled in the APK
# via .env so the in-app admin composer could call OneSignal directly,
# but decompiling the APK would leak the key. Notifications are now
# sent from the OneSignal Dashboard (https://dashboard.onesignal.com),
# which keeps the REST API key server-side only. The App ID is safe to
# ship in the APK — it identifies which OneSignal app to subscribe to
# but cannot be used to send notifications.
ONE_SIGNAL_APP_ID=YOUR_ONE_SIGNAL_APP_ID

# TMDB API Key (https://www.themoviedb.org/settings/api)
# Required for TMDB lookups (poster, cast, genres, search suggestions)
TMDB_API_KEY=YOUR_TMDB_API_KEY
