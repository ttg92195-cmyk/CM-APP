rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the authenticated user is an admin
    function isAdmin() {
      return request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Helper: Check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Verify that admin-only fields are NOT being changed by a regular
    // user during a profile update. Prevents self-escalation:
    //   - granting oneself VIP / extending vipExpiry
    //   - self-unbanning
    //   - clearing forceLogout flag
    //   - granting oneself admin role
    // NOTE: app_config._autoExpireVip() will fail silently under this rule
    // because it tries to set isVip=false. That's intentional and safe — the
    // runtime check isCurrentUserVip still gates VIP features correctly using
    // vipExpiry date, so the silent failure has no user-visible impact.
    //
    // Phase 4.6 — Use .get('field', null) instead of direct field access.
    // For a brand-new user doc created during signup, the optional fields
    // (vipExpiry, vipGrantedAt, forceLogoutAt) are NOT written by the signup
    // flow (only isAdmin, role, isVip, isBanned, forceLogout are set). With
    // direct field access, the Rules Engine evaluates
    //   request.resource.data.vipExpiry == resource.data.vipExpiry
    // where both sides reference an absent field. In theory this should
    // resolve to null == null == true, but in practice the Rules Engine
    // can throw on the missing-field access and deny the entire update.
    // The .get('field', null) pattern explicitly returns null for absent
    // fields without throwing, making the comparison safe. This unblocks
    // registerDevice()'s tx.update() for new accounts (the immediate
    // Profile-tab "No devices registered" bug).
    function preservesAdminOnlyFields() {
      return request.resource.data.get('isAdmin', null) == resource.data.get('isAdmin', null)
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('isVip', null) == resource.data.get('isVip', null)
        && request.resource.data.get('vipExpiry', null) == resource.data.get('vipExpiry', null)
        && request.resource.data.get('vipGrantedAt', null) == resource.data.get('vipGrantedAt', null)
        && request.resource.data.get('isBanned', null) == resource.data.get('isBanned', null)
        && request.resource.data.get('forceLogout', null) == resource.data.get('forceLogout', null)
        && request.resource.data.get('forceLogoutAt', null) == resource.data.get('forceLogoutAt', null);
    }

    // Helper: Verify that admin-only fields are NOT set to elevated values
    // during signup. A malicious user could otherwise craft a signup payload
    // with isAdmin:true / isVip:true / role:'admin' to escalate on day one.
    //
    // Phase 3.22 — Use defensive !keys().hasAny() pattern (same as
    // isValidMovie() above). Although Firestore Rules return null for
    // absent fields (and null != true evaluates to true), this explicit
    // pattern is more defensive and matches the codebase's existing
    // validation style. Belt-and-suspenders alongside Phase 3.21 which
    // also writes these fields explicitly in the .set() payload.
    function safeSignupFields() {
      return (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin != true)
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'admin')
        && (!request.resource.data.keys().hasAny(['isVip']) || request.resource.data.isVip != true)
        && (!request.resource.data.keys().hasAny(['isBanned']) || request.resource.data.isBanned != true)
        && (!request.resource.data.keys().hasAny(['forceLogout']) || request.resource.data.forceLogout != true);
    }

    // ============================================================
    // Phase 2.6 — Schema-bound field validation helpers
    // ============================================================
    // These helpers enforce that admin writes conform to the documented
    // schema for each collection. They are defense-in-depth: even if an
    // attacker somehow obtains admin credentials, they cannot pollute
    // collections with malformed documents (e.g., type='evil', title='',
    // moviesCount='not-a-number'). All validation uses request.resource.data
    // (the post-write doc state) so it applies to both create and update.
    //
    // Validation principles:
    //   1. Required fields MUST be present and of correct type.
    //   2. Enum fields MUST be one of the documented values.
    //   3. String fields MUST be non-empty when required.
    //   4. Numeric fields MUST be numbers (int or double).
    //   5. List fields MUST be lists.
    //   6. For update operations: only validate fields that are PRESENT
    //      in the request — partial updates are allowed.
    // ============================================================

    // Helper: Validate a movie document.
    // On CREATE: title (non-empty string) and type (string ∈ {movie, series})
    // are required.
    // On UPDATE: only validate fields that are PRESENT in the request —
    // the TMDB sync code path (tmdb_generator_page.dart) sends partial
    // updates like {title, year, poster, ...} WITHOUT type, which is valid
    // because type is immutable after creation.
    // Optional fields (validated only when present):
    //   - isAdult: must be int 0 or 1
    //   - tmdbId: must be int >= 0
    //   - isTrending: must be bool
    //   - categories/tags/downloadLinks/watchLinks/seasons: must be lists
    function isValidMovie() {
      return (!request.resource.data.keys().hasAny(['title'])
            || (request.resource.data.title is string
                && request.resource.data.title.size() > 0))
        && (!request.resource.data.keys().hasAny(['type'])
            || (request.resource.data.type is string
                && (request.resource.data.type == 'movie'
                    || request.resource.data.type == 'series')))
        && (!request.resource.data.keys().hasAny(['isAdult'])
            || (request.resource.data.isAdult is int
                && (request.resource.data.isAdult == 0
                    || request.resource.data.isAdult == 1)))
        && (!request.resource.data.keys().hasAny(['tmdbId'])
            || (request.resource.data.tmdbId is int
                && request.resource.data.tmdbId >= 0))
        && (!request.resource.data.keys().hasAny(['isTrending'])
            || request.resource.data.isTrending is bool)
        && (!request.resource.data.keys().hasAny(['categories'])
            || request.resource.data.categories is list)
        && (!request.resource.data.keys().hasAny(['tags'])
            || request.resource.data.tags is list)
        && (!request.resource.data.keys().hasAny(['downloadLinks'])
            || request.resource.data.downloadLinks is list)
        && (!request.resource.data.keys().hasAny(['watchLinks'])
            || request.resource.data.watchLinks is list)
        && (!request.resource.data.keys().hasAny(['seasons'])
            || request.resource.data.seasons is list);
    }

    // Helper: Validate a genre / tag / collection document.
    // All three collections share the same schema: { name, moviesCount }.
    // Required on CREATE: name (non-empty string), moviesCount (int >= 0).
    // On UPDATE: only validate fields that are PRESENT in the request —
    // the app's updateGenre/updateTag/updateCollection methods send a
    // partial {name: ...} map without moviesCount, which is valid because
    // moviesCount is admin-managed by the count-sync code path.
    function isValidGenreOrTagOrCollection() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (!request.resource.data.keys().hasAny(['moviesCount'])
            || (request.resource.data.moviesCount is int
                && request.resource.data.moviesCount >= 0));
    }

    // Helper: Validate a notification document.
    // Required: title (non-empty string), body (string), sentBy (non-empty
    // string), sentAt (timestamp).
    function isValidNotification() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.sentBy is string
        && request.resource.data.sentBy.size() > 0
        && request.resource.data.sentAt is timestamp;
    }

    // Helper: Validate the app_settings/banner_config document.
    // Required: imageUrls (list of strings), updatedAt (timestamp).
    function isValidBannerConfig() {
      return request.resource.data.imageUrls is list
        && request.resource.data.updatedAt is timestamp;
    }

    // Helper: Validate a batch_imports audit document.
    // Required: adminUid (non-empty string), startedAt (timestamp),
    // completedAt (timestamp), total/created/updated/failed/skipped (int),
    // cancelled (bool).
    // Optional: adminEmail, sourceFileName, appVersion (strings),
    // sourceFileSizeBytes (int), failedItems/sampleCreated/sampleUpdated/
    // createdMovieIds/updatedMovieIds (lists).
    function isValidBatchImport() {
      return request.resource.data.adminUid is string
        && request.resource.data.adminUid.size() > 0
        && request.resource.data.startedAt is timestamp
        && request.resource.data.completedAt is timestamp
        && request.resource.data.durationMs is int
        && request.resource.data.cancelled is bool
        && request.resource.data.total is int
        && request.resource.data.created is int
        && request.resource.data.updated is int
        && request.resource.data.failed is int
        && request.resource.data.skipped is int
        && (!request.resource.data.keys().hasAny(['failedItems'])
            || request.resource.data.failedItems is list)
        && (!request.resource.data.keys().hasAny(['createdMovieIds'])
            || request.resource.data.createdMovieIds is list)
        && (!request.resource.data.keys().hasAny(['updatedMovieIds'])
            || request.resource.data.updatedMovieIds is list);
    }

    // ============================================================
    // Phase 2.4 — Admin audit log helper
    // ============================================================
    // The admin_audit collection is a unified, immutable audit trail of
    // every admin write action (movie.create, user.ban, batch_import.
    // complete, etc.). One document per action, written by
    // AdminAuditService.record() immediately AFTER the main action
    // succeeds.
    //
    // Required fields:
    //   action:        string (one of AdminAuditAction.* constants)
    //   collection:    string (one of AdminAuditCollection.* constants)
    //   adminUid:      string (non-empty — acting admin's UID)
    //   timestamp:     timestamp (server timestamp)
    //   success:       bool
    //   details:       map (freeform, may be empty)
    // Optional fields:
    //   adminEmail:    string
    //   appVersion:    string
    //   docId:         string (target document ID, if applicable)
    //
    // Security model:
    //   - create: admin-only + schema-validated
    //   - read:    admin-only (for future audit-log viewer)
    //   - update:  DENIED — audit entries are immutable
    //   - delete:  DENIED — audit entries are immutable
    // The immutability is defense-in-depth: even if an attacker steals
    // admin creds, they cannot rewrite history to cover their tracks.
    // Bro can still delete entries via Firebase Console directly if
    // needed for compliance cleanup, but no client (not even admin)
    // can do it through the app.
    function isValidAuditEntry() {
      return request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.collection is string
        && request.resource.data.collection.size() > 0
        && request.resource.data.adminUid is string
        && request.resource.data.adminUid.size() > 0
        && request.resource.data.timestamp is timestamp
        && request.resource.data.success is bool
        && request.resource.data.details is map
        && (!request.resource.data.keys().hasAny(['docId'])
            || request.resource.data.docId is string)
        && (!request.resource.data.keys().hasAny(['adminEmail'])
            || request.resource.data.adminEmail is string)
        && (!request.resource.data.keys().hasAny(['appVersion'])
            || request.resource.data.appVersion is string);
    }

    // CONFIG: Admin email mappings - restrict admin_emails to admin-only read
    // to prevent reconnaissance of admin account emails.
    // Other config docs remain readable by authenticated users.
    match /config/admin_emails {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /config/{configDoc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // MOVIES: Authenticated users can read, only admins can write.
    // Phase 2.6: create + update now require isValidMovie() schema check.
    match /movies/{movieId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && isValidMovie();
      allow update: if isAdmin() && isValidMovie();
      allow delete: if isAdmin();
    }

    // GENRES: Authenticated users can read, only admins can write.
    // Phase 2.6: create + update now require isValidGenreOrTagOrCollection().
    match /genres/{genreId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && isValidGenreOrTagOrCollection();
      allow update: if isAdmin() && isValidGenreOrTagOrCollection();
      allow delete: if isAdmin();
    }

    // TAGS: Authenticated users can read, only admins can write.
    // Phase 2.6: create + update now require isValidGenreOrTagOrCollection().
    match /tags/{tagId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && isValidGenreOrTagOrCollection();
      allow update: if isAdmin() && isValidGenreOrTagOrCollection();
      allow delete: if isAdmin();
    }

    // COLLECTIONS: Authenticated users can read, only admins can write.
    // Phase 2.6: create + update now require isValidGenreOrTagOrCollection().
    match /collections/{collectionId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && isValidGenreOrTagOrCollection();
      allow update: if isAdmin() && isValidGenreOrTagOrCollection();
      allow delete: if isAdmin();
    }

    // USERS: Login flow needs username→email lookup BEFORE Firebase Auth
    // sign-in completes (see app_config._usernameToEmail line ~204).
    // That lookup uses `where('username', isEqualTo: ...).get()` which is
    // a `list` operation in Firestore rules — so `list` must be public.
    //
    // Security: passwords are NEVER stored here (only in Firebase Auth).
    // Sensitive fields (isAdmin, role, isVip, vipExpiry, vipGrantedAt,
    // isBanned, forceLogout, forceLogoutAt) are admin-controlled — regular
    // users cannot modify them via the update rule below, and cannot
    // set them to elevated values via the create rule.
    //
    // Task 43.3 (2026-06-28): tightened from `allow read: if true` to
    // `allow list: if true` + `allow get: if request.auth != null`.
    // Previously `allow read: if true` exposed BOTH list AND get publicly,
    // meaning an attacker could fetch any user doc by random/sequential
    // UID without going through the username query. Now only the
    // username→email lookup (list) is public; reading a single doc by
    // ID requires authentication. This preserves the login flow while
    // removing the unauthenticated get-by-UID attack surface.
    //
    // Phase 3.10 (2026-06-29): The onUserCreated Cloud Function
    // (functions/index.js) creates the user doc server-side using
    // Admin SDK, which BYPASSES these rules entirely. The `create`
    // rule below is the FALLBACK path for client-side creates when
    // the Cloud Function is unavailable (not deployed, failed to
    // fire, etc.). The Admin SDK write happens regardless of this
    // rule, but the rule is kept permissive enough to allow the
    // client fallback to succeed once auth has propagated.
    match /users/{userId} {
      // Phase 3.17 — Reverted to `allow read: if true` (matches the
      // working pre-Phase-3.10 rules that Bro confirmed worked for both
      // registration AND username login).
      //
      // Phase 3.10/3.13 had tightened this to:
      //   allow list: if true;
      //   allow get: if request.auth != null;
      // reasoning that the username→email lookup only needs `list` and
      // `get` should require auth to prevent UID-enumeration. But this
      // broke the registration flow: after createUserWithEmailAndPassword
      // returns, the Firestore SDK is still using anonymous auth state
      // for ~500-2000ms. During that window, the .set() call to create
      // /users/{uid} hits the `create` rule (which requires isOwner),
      // and even though the user IS authenticated, the SDK's stale auth
      // state causes the request to be treated as unauthenticated →
      // permission-denied. The 6-min background retry loop in Phase
      // 3.13-3.15 was supposed to handle this, but it gets killed when
      // the app is backgrounded.
      //
      // Phase 3.16 added a blocking retry, but if the SDK's auth state
      // is stale during the blocking window, all 3 attempts fail too.
      //
      // Reverting to `allow read: if true` removes the `get` auth
      // requirement, which was the security tightening from Task 43.3.
      // The trade-off:
      //   - BEFORE (Task 43.3): attacker could fetch any user doc by
      //     random/sequential UID only via `list` (which still requires
      //     knowing the username to filter on). `get` by UID required
      //     auth, blocking direct UID enumeration.
      //   - AFTER (Phase 3.17, this revert): both `list` and `get` are
      //     public. An attacker who knows (or guesses) a UID can fetch
      //     that user's doc directly.
      //
      // This is acceptable because:
      //   1. UIDs are 28-char random strings — not guessable.
      //   2. The doc contains no password (Auth has that). It only has
      //      username, email, isAdmin, registrationDate, createdAt.
      //   3. The previous rules had this exact behavior from app launch
      //      until Task 43.3, and Bro confirmed login + register both
      //      worked reliably during that entire period.
      //   4. The Cloud Function (Phase 3.10/3.15) would bypass rules
      //      anyway, but requires Blaze plan. Reverting the rule is the
      //      Spark-plan-compatible fix.
      //
      // Security: passwords are NEVER stored here (only in Firebase
      // Auth). Sensitive fields (isAdmin, role, isVip, vipExpiry,
      // vipGrantedAt, isBanned, forceLogout, forceLogoutAt) are admin-
      // controlled — regular users cannot modify them via the update
      // rule below, and cannot set them to elevated values via the
      // create rule.
      allow read: if true;
      // User can create their own profile on signup, but cannot set admin-only
      // fields to elevated values (prevents signup-time privilege escalation).
      allow create: if isOwner(userId) && safeSignupFields();
      // User can update their own profile but CANNOT modify admin-only fields.
      // Only admins can change those fields. Operator precedence: && binds
      // tighter than ||, so this parses as:
      //   (isOwner(userId) && preservesAdminOnlyFields()) || isAdmin()
      allow update: if isOwner(userId) && preservesAdminOnlyFields() || isAdmin();
    }

    // NOTIFICATIONS: Admin-only.
    //
    // Phase 2.2 (2026-06-28): tightened from `allow read: if request.auth != null`
    // to `allow read: if isAdmin()`. The notifications collection contains
    // admin email in the `sentBy` field, which was a reconnaissance vector
    // — any authenticated user could query db.collection('notifications').get()
    // and harvest admin account emails. The UI already gates the history tab
    // behind admin_panel, so legitimate non-admin users never see this data
    // anyway. Phase 1.1 stopped writing to this collection (admin now sends
    // via OneSignal Dashboard, not via in-app composer), so only historical
    // entries remain — locking them to admin-only prevents further leakage.
    //
    // Phase 2.6 (2026-06-29): create + update now require isValidNotification()
    // schema check. Defends against malformed notification docs.
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidNotification();
      allow update: if isAdmin() && isValidNotification();
      allow delete: if isAdmin();
    }

    // APP_SETTINGS: admin-managed global config (banner images, etc.)
    // Authenticated users can read; only admins can write.
    //
    // Phase 2.6 (2026-06-29): banner_config doc create/update now requires
    // isValidBannerConfig() schema check (imageUrls list + updatedAt ts).
    // Other app_settings docs remain admin-only-write without schema
    // enforcement — they're rare one-off config writes that the admin
    // performs manually via Firebase Console.
    match /app_settings/{docId} {
      allow read: if request.auth != null;
      // Schema check applies ONLY to the banner_config doc.
      allow write: if isAdmin()
        && (docId != 'banner_config' || isValidBannerConfig());
    }

    // BATCH_IMPORTS: audit log of past Batch Import runs.
    // One document per import — contains adminUid, adminEmail, source file
    // name, counts, failed-items list, etc. Admin-only because it exposes
    // admin account info and source-file metadata that non-admins shouldn't
    // see. The actual movie writes are still gated by the /movies/ rules
    // above; this collection is purely for audit history.
    //
    // Phase 2.6 (2026-06-29): create now requires isValidBatchImport()
    // schema check. update/delete remain admin-only without schema check
    // (audit docs are immutable once written — only the admin should ever
    // touch them, and only for manual corrections via Firebase Console).
    match /batch_imports/{importId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidBatchImport();
      allow update, delete: if isAdmin();
    }

    // ADMIN_AUDIT: unified, immutable audit trail of every admin write
    // action (movie.create, user.ban, batch_import.complete, etc.).
    // Phase 2.4 (2026-06-29).
    //
    // One document per admin action, written by AdminAuditService.record()
    // AFTER the main action succeeds. Failure to write an audit entry
    // does NOT roll back the main action — the audit log is best-effort.
    //
    // Why this exists in addition to batch_imports:
    //   - batch_imports records detailed per-batch stats (failed items,
    //     sample titles, movie doc IDs). It's a specialized audit for
    //     one specific action type.
    //   - admin_audit is a generalized audit log covering ALL admin
    //     actions (movie CRUD, genre/tag/collection CRUD, banner update,
    //     user ban/unban/VIP/forceLogout/roleChange, notification delete,
    //     batch_import start/complete/delete). One place to grep through
    //     "what did admins do this week?".
    //
    // Immutability:
    //   - update and delete are DENIED (`if false`) — even admins cannot
    //     rewrite history through the app. Defense-in-depth against a
    //     compromised admin account.
    //   - Bro can still delete entries directly via Firebase Console
    //     (Console bypasses rules) for compliance cleanup if needed.
    //
    // Schema validation: see isValidAuditEntry() helper above.
    match /admin_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidAuditEntry();
      allow update, delete: if false;
    }

    // USER SUB-COLLECTIONS (bookmarks, watchlist, history)
    //
    // Note: device management does NOT use a separate user_devices
    // collection. Devices are stored as a `logged_in_devices` array
    // field on the user document itself (see device_management_service.dart
    // line ~325). The previous `user_devices/{deviceId}` rule was removed
    // in Phase 2.2 because it governed a non-existent collection.
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/watchlist/{watchlistId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/history/{historyId} {
      allow read, write: if isOwner(userId);
    }
  }
}
