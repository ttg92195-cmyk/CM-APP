rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the authenticated user is an admin
    function isAdmin() {
      return request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Helper: Check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // CONFIG: Admin email mappings - restrict admin_emails to admin-only read
    // to prevent reconnaissance of admin account emails.
    // Other config docs remain readable by authenticated users.
    match /config/admin_emails {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /config/{configDoc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // MOVIES: Authenticated users can read, only admins can write
    match /movies/{movieId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // GENRES: Authenticated users can read, only admins can write
    match /genres/{genreId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // TAGS: Authenticated users can read, only admins can write
    match /tags/{tagId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // COLLECTIONS: Authenticated users can read, only admins can write
    match /collections/{collectionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // USERS: Public read for username→email lookup during login (login happens before auth)
    // Security: passwords are NEVER stored here (only in Firebase Auth).
    // Sensitive fields like forceLogout/isBanned are admin-controlled via update rules.
    match /users/{userId} {
      // Public read so username-based login can resolve username → email before auth.
      // This is required because Firebase Auth needs email, but user types username.
      allow read: if true;
      // User can create their own profile on signup
      allow create: if isOwner(userId);
      // User can update their own profile but CANNOT change isAdmin/role fields
      // (only admins can grant/revoke admin or role)
      allow update: if isOwner(userId)
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.role == resource.data.role
        || isAdmin();
    }

    // NOTIFICATIONS: Admin can write, authenticated users can read their own notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // USER SUB-COLLECTIONS (bookmarks, watchlist, history)
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/watchlist/{watchlistId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/history/{historyId} {
      allow read, write: if isOwner(userId);
    }
  }
}
