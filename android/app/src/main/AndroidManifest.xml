<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Storage permissions for downloading -->
    <!-- Android 9 and below: WRITE_EXTERNAL_STORAGE needed for public Download dir -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 12 and below: READ_EXTERNAL_STORAGE needed for file access -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 11+: Uses scoped storage (app-specific external directory).
         No MANAGE_EXTERNAL_STORAGE needed - avoids Google Play Store rejection.
         Downloads are saved to app-specific external storage which is accessible
         via file managers and doesn't require broad permissions. -->

    <application
        android:label="KMM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Firebase App Check debug token for CI/release builds -->
        <meta-data
            android:name="firebase_app_check_debug_token"
            android:value="42B8C81C-0451-4847-B033-7DAAAAC8415F" />
    </application>
</manifest>
