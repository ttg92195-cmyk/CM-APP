<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Task 42#3 — <queries> block required by Android 11+ (API 30+)
         for canLaunchUrl() / launchUrl() to resolve external app intents.
         Without this, canLaunchUrl('https://www.youtube.com/...') returns
         false silently, and the Trailer button on movie/series detail
         pages appears dead (Bro's report). Declaring http/https scheme
         visibility lets url_launcher query any browser / YouTube app
         that registers for the URL. We also explicitly declare the
         YouTube intent so url_launcher can prefer the native YouTube
         app when installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Storage permissions for downloading -->
    <!-- Android 9 and below: WRITE_EXTERNAL_STORAGE needed for public Download dir -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 12 and below: READ_EXTERNAL_STORAGE needed for file access -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+: Granular media permission for videos (replaces READ_EXTERNAL_STORAGE) -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 13+: Required for showing notifications (download progress) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 11+: Uses scoped storage (app-specific external directory).
         No MANAGE_EXTERNAL_STORAGE needed - avoids Google Play Store rejection.
         Downloads are saved to app-specific external storage which is accessible
         via file managers and doesn't require broad permissions. -->

    <application
        android:label="KMM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
