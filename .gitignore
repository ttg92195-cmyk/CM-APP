# Environment variables — NEVER commit .env to version control!
# Contains Firebase API keys and project secrets.
# Copy .env.example to .env and fill in your values.
.env

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
# L6: pubspec.lock should be committed for apps (not packages) to ensure
# reproducible builds and prevent supply-chain dependency attacks.
# Only ignore other lock files (e.g., Podfile.lock is handled by iOS section)
*.lock
!pubspec.lock

# Android
key.properties
*.jks
android/app/debug
android/app/profile
android/app/release

# iOS
ios/Pods/
ios/.symlinks/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Generated
*.g.dart
*.freezed.dart
