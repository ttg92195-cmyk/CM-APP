# Environment variables — .env is committed because the app bundles it at build time.
# .env.example is available for reference but .env itself must be in the repo
# for GitHub Actions CI/CD builds to work (flutter_dotenv loads it as an asset).
# .env

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
# L6: pubspec.lock should be committed for apps (not packages) to ensure
# reproducible builds and prevent supply-chain dependency attacks.
# Only ignore other lock files (e.g., Podfile.lock is handled by iOS section)
*.lock
!pubspec.lock

# Android
key.properties
*.jks
android/app/debug
android/app/profile
android/app/release

# iOS
ios/Pods/
ios/.symlinks/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Generated
*.g.dart
*.freezed.dart
